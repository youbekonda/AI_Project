# LLM used for answer generation. Retrieval and indexing work without a key;
# the UI shows an error if generation is attempted without credentials.
# Set keys in deploy secrets or a local .env (never commit real keys).
#
# LLM_PROVIDER picks the client:
#   anthropic -> Claude via the Anthropic SDK (ANTHROPIC_API_KEY, LLM_EFFORT)
#   openai    -> any OpenAI-compatible endpoint (LLM_API_KEY, LLM_BASE_URL)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# LLM_TIMEOUT_SECONDS=90

# Groq free tier alternative (set LLM_PROVIDER=openai and LLM_MODEL below)
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# FastAPI (api/main.py) — set on Railway / Render / Fly
# Comma-separated browser origins allowed to call the API (Vercel URL).
# Use * for local demos; tighten in production.
CORS_ORIGINS=*

# Next.js (web/) — set on Vercel as NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_API_URL=https://your-campusask-api.up.railway.app

# Optional overrides (defaults match src/config.py)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=8
# EVIDENCE_MIN_SCORE=0.38
